services:
  bot:
    build: .
    restart: unless-stopped
<<- if .Doppler >>
    environment:
      # Provide a Doppler service token so the container can fetch its secrets
      - DOPPLER_TOKEN=${DOPPLER_TOKEN}
<<- else >>
    env_file:
      - .env
<<- end >>
    volumes:
      - ./logs:/app/logs
      - ./botbox.conf:/app/botbox.conf:ro

