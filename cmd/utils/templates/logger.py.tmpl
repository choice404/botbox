import logging
import os
import sys
from logging.handlers import RotatingFileHandler

LOG_FORMAT = "%(asctime)s [%(levelname)-8s] %(name)s: %(message)s"
LOG_FILE_NAME = "bot.log"
MAX_BYTES = 5 * 1024 * 1024
BACKUP_COUNT = 5

def setup_logging() -> logging.Logger:
    """
    Configures the root logger with a rotating file handler and a stdout handler

        Parameters:
                None

        Returns:
                logging.Logger: The configured root logger
    """

    level_name = os.getenv("LOG_LEVEL", "INFO").upper()
    level = getattr(logging, level_name, logging.INFO)
    if not isinstance(level, int):
        level = logging.INFO

    log_dir = os.getenv("LOG_DIR", "logs")
    os.makedirs(log_dir, exist_ok=True)

    formatter = logging.Formatter(LOG_FORMAT)

    file_handler = RotatingFileHandler(
        os.path.join(log_dir, LOG_FILE_NAME),
        maxBytes=MAX_BYTES,
        backupCount=BACKUP_COUNT,
        encoding="utf-8",
    )
    file_handler.setFormatter(formatter)

    stream_handler = logging.StreamHandler(sys.stdout)
    stream_handler.setFormatter(formatter)

    root_logger = logging.getLogger()
    root_logger.setLevel(level)

    # Drop handlers left by an earlier call so a repeated setup does not duplicate output
    for handler in list(root_logger.handlers):
        root_logger.removeHandler(handler)
        handler.close()

    root_logger.addHandler(file_handler)
    root_logger.addHandler(stream_handler)

    # discord.py is chatty at INFO, keep it to warnings and above
    logging.getLogger("discord").setLevel(logging.WARNING)

    return root_logger

def get_logger(name: str) -> logging.Logger:
    """
    Returns a named logger that inherits the root configuration

        Parameters:
                name (str): The logger name, usually __name__

        Returns:
                logging.Logger: The named logger
    """

    return logging.getLogger(name)

